{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],

    // 
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions":true,
    "rewriteRelativeImportExtensions": true,

    //
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false
  },
  "include":["src/**/*"],
  "exclude":["node_modules","dist"]
}